{
  "name": "bloclchain",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:client": "vite build",
    "build:server": "esbuild server/index.ts --platform=node --format=esm --packages=external --bundle --outfile=dist-server/index.js && esbuild server/applySchema.ts --platform=node --format=esm --packages=external --bundle --outfile=dist-server/applySchema.js",
    "build": "npm run build:client && npm run build:server",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "preview": "vite preview",
    "db:setup": "node dist-server/applySchema.js",
    "package": "bash package-for-cpanel.sh",
    "start": "node app.js"
  },
  "dependencies": {
    "@reown/appkit": "^1.8.23",
    "@reown/appkit-adapter-wagmi": "^1.8.23",
    "@tanstack/react-query": "^5.101.4",
    "ethers": "^6.17.0",
    "lucide-react": "^1.28.0",
    "mysql2": "^3.24.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "tsx": "^4.19.4",
    "viem": "2.55.19",
    "wagmi": "^3.7.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "esbuild": "^0.28.2",
    "oxlint": "^1.75.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
